# Copy to .env (or export in the environment) and fill in real values.
# The application refuses to start without JWT_SECRET outside the dev profile.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/shopupu
DB_USERNAME=shopupu
DB_PASSWORD=
DB_POOL_SIZE=10

# --- JWT ---
# At least 32 bytes. Generate with: openssl rand -hex 48
JWT_SECRET=
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=shopupu
JWT_AUDIENCE=shopupu-api

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://shop.example.com

# --- Payments ---
# stub | bank_back | monobank | fondy
PAYMENTS_DEFAULT_PROVIDER=stub
PAYMENT_CURRENCY=EUR
PAYMENT_SERVICE_BASE_URL=
PAYMENT_SERVICE_CLIENT_ID=shopupu
PAYMENT_SERVICE_SECRET=
PAYMENT_CALLBACK_SECRET=
PAYMENT_CALLBACK_URL=https://shop.example.com/api/payments/callback
MONOBANK_TOKEN=
FONDY_MERCHANT_ID=
FONDY_SECRET=

# --- Uploads ---
UPLOADS_DIR=uploads
PUBLIC_UPLOADS_BASE_URL=https://cdn.example.com/uploads

# --- Bootstrap admin (one-off provisioning) ---
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
