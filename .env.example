# Copy to .env and fill in real values. NEVER commit the real .env (it is gitignored).
# The application refuses to start without JWT_SECRET outside the dev profile.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/shopupu
DB_USERNAME=shopupu
# A generated password is required even for a fresh local Compose database.
DB_PASSWORD=
DB_POOL_SIZE=10
# Separate production runtime account, after ops/bootstrap-db.sql + migration/grants.
DB_RUNTIME_USERNAME=shopupu_runtime
DB_RUNTIME_PASSWORD=
# Migration credentials belong only to the deployment process, never runtime.
# FLYWAY_URL=jdbc:postgresql://<migration-target>:5432/shopupu
# FLYWAY_USER=shopupu_migrator
# FLYWAY_PASSWORD=

# --- JWT ---
# At least 32 bytes. Generate with: openssl rand -hex 48
JWT_SECRET=
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=shopupu
JWT_AUDIENCE=shopupu-api

# Required for ADMIN/MANAGER sign-in, including first TOTP enrollment.
# Generate once: openssl rand -base64 32. Store/backup in the secret manager.
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Shopupu Demo

# --- Frontend / CORS ---
# Comma-separated exact origins of your frontend(s). No wildcards (credentials are sent).
CORS_ALLOWED_ORIGINS=https://shop.example.com
# Public base URL of the SPA; used to build password-reset / verify-email links.
FRONTEND_BASE_URL=https://shop.example.com

# --- Sign in with Google (AUTH-13) ---
# OAuth 2.0 Web Client ID from Google Cloud Console. Blank => Google login is off
# and the frontend hides the button. The frontend needs the SAME value as
# NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# --- Email: explicitly disabled until owner verifies a sender ---
NOTIFICATION_PROVIDER=disabled
# disabled | smtp | resend (credentials alone do not enable sending)
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=
RESEND_TIMEOUT_SECONDS=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true
# Include the SMTP connection probe in /actuator/health (only sensible with NOTIFICATION_PROVIDER=smtp)
MAIL_HEALTH_ENABLED=false

# --- Demo payments: only local simulation or Stripe test mode ---
PAYMENTS_DEFAULT_PROVIDER=stub
PAYMENT_CURRENCY=EUR
# Both are required to enable Stripe checkout. sk_live keys are rejected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_REQUEST_TIMEOUT_SECONDS=10
# Legacy custom-signature route is closed when Stripe is selected.
PAYMENT_CALLBACK_SECRET=
PAYMENT_CALLBACK_URL=https://shop.example.com/api/v1/payments/callback

# --- Uploads ---
UPLOADS_DIR=uploads
PUBLIC_UPLOADS_BASE_URL=https://cdn.example.com/uploads

# --- Reverse proxy / client IP ---
# Set to "framework" ONLY when behind a trusted proxy/tunnel that overwrites
# X-Forwarded-For. Leave as "none" (default) on direct exposure — the rate limiter
# derives the client IP from the framework peer address, so a wrong value here
# either over-throttles (all traffic shares one bucket) or, if a proxy forwards
# untrusted XFF, weakens per-IP limits.
SERVER_FORWARD_HEADERS_STRATEGY=none
# Cloudflare Tunnel deployments: strategy=native + the header Cloudflare overwrites with the
# real client address (only trusted because the origin accepts loopback connections only).
# SERVER_FORWARD_HEADERS_STRATEGY=native
# SERVER_TOMCAT_REMOTEIP_REMOTE_IP_HEADER=CF-Connecting-IP

# --- Retention (LEG-06) ---
# ISO-8601 periods; defaults are what the "Data and privacy" page states. Change the page too.
RETENTION_ENABLED=true
RETENTION_AUDIT_EVENTS=P12M
RETENTION_INACTIVE_ACCOUNTS=P12M
RETENTION_ERASED_ACCOUNT_RECORDS=P24M

# --- Bootstrap admin (one-off provisioning) ---
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- AI features: semantic search, recommendations, review summaries ---
# Off by default; with stub providers no external calls are made and no keys are needed.
AI_ENABLED=false

# Embeddings (semantic search + "similar"): stub | ollama | local (TEI) | voyage
AI_EMBEDDING_PROVIDER=ollama
# 1024-dim models only (must match the V15 vector column)
AI_EMBEDDING_MODEL=bge-m3
# ollama: http://localhost:11434 (default if blank) · TEI: http://localhost:8081 · voyage base-url override
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_DIM=1024
VOYAGE_API_KEY=

# LLM (review summaries + NL query parse): stub | deepseek (OpenAI-compatible)
AI_LLM_PROVIDER=stub
# Fixed single-call model; keep thinking disabled.
AI_LLM_MODEL=deepseek-v4-flash
# blank => https://api.deepseek.com; can point at any OpenAI-compatible server (e.g. http://localhost:11434/v1)
AI_LLM_BASE_URL=
DEEPSEEK_API_KEY=

AI_REQUEST_TIMEOUT_SECONDS=15
AI_REVIEW_SUMMARY_MIN_REVIEWS=3
AI_MAX_CONCURRENT_CALLS=2
AI_EXTERNAL_CALLS_PER_MINUTE=30
AI_EXTERNAL_CALLS_PER_DAY=500
AI_EXTERNAL_TOKENS_PER_MINUTE=60000
AI_EXTERNAL_TOKENS_PER_DAY=500000
AI_MAX_INPUT_BYTES=24000
AI_MAX_OUTPUT_TOKENS=800
AI_MAX_RESPONSE_BYTES=262144
AI_REQUESTS_PER_MINUTE=20
AI_REQUESTS_PER_DAY=200
AI_MAX_TRACKED_CLIENTS=10000
AI_QUERY_CACHE_ENTRIES=256
AI_QUERY_CACHE_MINUTES=10

# --- Cloudflare Tunnel (optional; docker compose --profile tunnel up -d cloudflared) ---
# Quick tunnel needs no token (random *.trycloudflare.com URL). For a named tunnel
# bound to your own hostname, create it in the Cloudflare dashboard and paste its token.
TUNNEL_TOKEN=
# When exposing via a tunnel, trust its forwarded headers and point callbacks/CORS at it:
# SERVER_FORWARD_HEADERS_STRATEGY=framework
# PAYMENT_CALLBACK_URL=https://<your-tunnel-host>/api/v1/payments/callback
# CORS_ALLOWED_ORIGINS=https://<your-frontend-host>
